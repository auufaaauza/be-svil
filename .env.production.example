APP_NAME=SVIL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api2.findmycareer.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Use the exact frontend origin and host. Next.js proxies /api and /sanctum.
FRONTEND_URL=https://fe-svil.vercel.app
SANCTUM_STATEFUL_DOMAINS=fe-svil.vercel.app

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_svil
DB_USERNAME=cpaneluser_svil
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Configure the certificate path when required by your managed MySQL provider.
# MYSQL_ATTR_SSL_CA=/path/to/provider-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=svil_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Mount persistent storage for storage/app/private. Files must remain private.

LOG_CHANNEL=stack
LOG_LEVEL=warning
MAIL_MAILER=log
# No demo password in production. Provision the first admin with svil:create-admin.
